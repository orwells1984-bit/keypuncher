<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows first (the plan's Phases 1 to 3); other heads come back in Phase 4 if tablets do. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Keypuncher.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Keypuncher</ApplicationTitle>
    <ApplicationId>is.keypuncher.toy</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Family use: run straight from the build folder, no MSIX install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keypuncher.Platform.Windows\Keypuncher.Platform.Windows.csproj" />
    <ProjectReference Include="..\Keypuncher.Rendering\Keypuncher.Rendering.csproj" />
    <ProjectReference Include="..\Keypuncher.Toy\Keypuncher.Toy.csproj" />
    <ProjectReference Include="..\Keypuncher.Director\Keypuncher.Director.csproj" />
    <ProjectReference Include="..\Keypuncher.Inference.Ollama\Keypuncher.Inference.Ollama.csproj" />
  </ItemGroup>

</Project>
